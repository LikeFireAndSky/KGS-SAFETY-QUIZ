{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBQuizTableReadOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:ap-northeast-2:790709146611:table/KGS-Safety-Quiz"
    },
    {
      "Sid": "DynamoDBParticipantsTableReadWrite",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:ap-northeast-2:790709146611:table/KGS-Safety-Quiz-Participants"
    },
    {
      "Sid": "S3QuizImageRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::kgs-safety-quiz-bucket/*"
    },
    {
      "Sid": "S3QuizBucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::kgs-safety-quiz-bucket"
    }
  ]
}
